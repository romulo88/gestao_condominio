# Lido por backend/src/main/resources/application.yml (Spring resolve variável de
# ambiente do sistema operacional - copiar pra .env não basta, precisa exportar de
# verdade ou usar um plugin de dotenv na hora de rodar).

# MinIO (S3-compatible) - storage local de anexos (fotos/PDFs de demandas)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="condominio"
MINIO_SECRET_KEY="condominio123"
MINIO_BUCKET="condominio-gestao"

# JWT - gere um valor de verdade (32+ bytes aleatórios) antes de produção.
# Sem isso definido, usa o default de dev do application.yml (inseguro, só local).
JWT_SECRET="dev-only-secret-troque-isso-em-producao-1234567890abcdefghij"

# Conexão do Postgres (usuário/senha/banco) já vem fixa em application.yml, batendo com
# o docker-compose.yml - não precisa repetir aqui.
